.DEFAULT_GOAL := values

values:
	find templates -type f -name "_values.yaml" -print0 | LC_COLLATE=C sort -z | xargs -0  sed -s -e '$$a\\' | cat > values.yaml
	@sed -i '1s;^;# !!! ATTENTION. Do not edit this file by hand. Run "make values" to generate it.\n\n;' values.yaml

template: values
	@helm template dbos-app . ${helm-options}  --output-dir ${output-dir};

secrets:
	@mkdir -p ${output-dir}
	@$(call secret,backend,_secrets)
	@$(call secret,backend-db,_secrets)
	@$(call secret,keycloak,_secrets)
	@$(call secret,keycloak-db,_secrets)

define secret
	cp templates/$(1)/$(2).yaml templates/$(1)/secrets.yaml
	helm template . ${helm-options} -s templates/$(1)/secrets.yaml \
		| kubeseal -n dbos --controller-namespace kube-system --controller-name sealed-secrets --format yaml \
		> ${output-dir}/$$(echo ${1} | sed 's/\//\-/g')-sealed$$(echo ${2} | sed 's/_/-/g').yaml;
	rm templates/$(1)/secrets.yaml
endef